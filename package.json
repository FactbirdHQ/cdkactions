{
  "name": "cdkactions",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FactbirdHQ/cdkactions.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean",
    "synth:workflows": "bun run --filter @factbird/cdkactions build && bun cicd/main.ts"
  },
  "devDependencies": {
    "@factbird/cdkactions": "workspace:*",
    "constructs": "^10.4.2"
  }
}
